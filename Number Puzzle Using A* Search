
import heapq

GOAL = (1, 2, 3, 4, 5, 6, 7, 8, 0)


def heuristic(state):
    distance = 0

    for i, tile in enumerate(state):
        if tile != 0:
            goal_index = GOAL.index(tile)

            row, col = divmod(i, 3)
            goal_row, goal_col = divmod(goal_index, 3)

            distance += abs(row - goal_row)
            distance += abs(col - goal_col)

    return distance


def get_neighbors(state):
    neighbors = []
    blank = state.index(0)
    row, col = divmod(blank, 3)

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_index = new_row * 3 + new_col

            new_state = list(state)
            new_state[blank], new_state[new_index] = (
                new_state[new_index], new_state[blank]
            )

            neighbors.append(tuple(new_state))

    return neighbors


def a_star(start):
    priority_queue = [(heuristic(start), 0, start)]
    came_from = {}
    cost_so_far = {start: 0}

    while priority_queue:
        f, g, current = heapq.heappop(priority_queue)

        if current == GOAL:
            path = [current]

            while current in came_from:
                current = came_from[current]
                path.append(current)

            return path[::-1]

        if g != cost_so_far[current]:
            continue

        for neighbor in get_neighbors(current):
            new_cost = g + 1

            if new_cost < cost_so_far.get(neighbor, float("inf")):
                cost_so_far[neighbor] = new_cost
                came_from[neighbor] = current

                priority = new_cost + heuristic(neighbor)

                heapq.heappush(
                    priority_queue,
                    (priority, new_cost, neighbor)
                )

    return None


def display(state):
    for i in range(0, 9, 3):
        print(" ".join(
            "_" if tile == 0 else str(tile)
            for tile in state[i:i + 3]
        ))
    print()


# Main program
start = (1, 2, 3, 4, 0, 6, 7, 5, 8)

solution = a_star(start)

if solution:
    print("Solution found!")
    print("Minimum moves:", len(solution) - 1)

    for step, state in enumerate(solution):
        print("Step", step)
        display(state)
else:
    print("No solution found.")
